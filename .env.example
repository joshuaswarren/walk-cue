# mock works with no keys and never calls a model.
# Set live to use an OpenAI-compatible server such as Ollama.
WALK_CUE_LLM_MODE=mock

# Include /v1, or stop at the server root. Both work.
# Ollama:    http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
WALK_CUE_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Whatever name that server expects. Ollama's Gemma 3 tag is gemma3.
WALK_CUE_LLM_MODEL=gemma3

# Optional bearer token. Leave empty for a typical local server.
WALK_CUE_LLM_API_KEY=

# Seconds to wait on the model before using the offline cue.
WALK_CUE_LLM_TIMEOUT=20

WALK_CUE_HOST=127.0.0.1
WALK_CUE_PORT=8000
